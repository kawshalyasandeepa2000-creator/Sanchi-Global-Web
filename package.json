{
  "name": "senchi-global-llc-static-cloudflare",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "SENCHI GLOBAL LLC static website with email inquiries via Web3Forms (no custom backend)",
  "scripts": {
    "start": "wrangler pages dev public --port 8788",
    "dev": "wrangler pages dev public --port 8788",
    "check": "node --check public/js/site.js && node --check public/js/site-config.js",
    "deploy": "wrangler pages deploy public --project-name sanchi-global-web"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
